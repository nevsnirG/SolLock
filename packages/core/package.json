    "@solana-program/stake": "0.11.0",
    "@solana-program/system": "0.16.0",
    "@solana/kit": "8.6.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "litesvm": "1.6.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
