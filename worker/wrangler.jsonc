{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A plain wrangler deploy without --env lands here, so this must never be the production name.
  "name": "sollock-dev",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",

  "dev": { "port": 8791, "ip": "127.0.0.1" },

  "assets": {
    "directory": "../web/dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },

  // No logs of any kind: they would record visitors' IPs and wallet addresses. Environments inherit this.
  "observability": { "enabled": false, "logs": { "enabled": false } },
  "logpush": false,

  "vars": {
    "CLUSTER": "devnet",
    "ALLOWED_ORIGINS": "https://sollock.io,https://www.sollock.io"
  },

  // Counted per data centre, not globally. The period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RPC_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    // getProgramAccounts is heavy for the RPC provider, hence the lower limit.
    { "name": "LOOKUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  // Wrangler does not pass vars or ratelimits on to environments, so each one repeats them.
  "env": {
    "staging": {
      "name": "sollock-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "devnet.sollock.io", "custom_domain": true }],
      "vars": {
        "CLUSTER": "devnet",
        "ALLOWED_ORIGINS": "https://devnet.sollock.io"
      },
      "ratelimits": [
        { "name": "RPC_LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
        { "name": "LOOKUP_LIMITER", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
      ]
    },
    "production": {
      "name": "sollock",
      "workers_dev": false,
      "routes": [
        { "pattern": "sollock.io", "custom_domain": true },
        { "pattern": "www.sollock.io", "custom_domain": true }
      ],
      "vars": {
        "CLUSTER": "mainnet",
        "ALLOWED_ORIGINS": "https://sollock.io,https://www.sollock.io"
      },
      "ratelimits": [
        { "name": "RPC_LIMITER", "namespace_id": "3001", "simple": { "limit": 120, "period": 60 } },
        { "name": "LOOKUP_LIMITER", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
