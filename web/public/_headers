# Static files bypass the Worker. This CSP only adds frame-ancestors, which the hashed <meta> CSP cannot set.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The build names every file under /_astro after a hash of its contents, so a browser can keep one for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
