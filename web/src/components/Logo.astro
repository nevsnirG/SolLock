---
import { LOCK_BOX, LOCK_PATHS, viewBox } from '../lib/lockIcon.ts';

interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<svg width={size} height={size} viewBox={viewBox(LOCK_BOX)} aria-hidden="true">
  <path class="logo-shackle" d={LOCK_PATHS.shackle}></path>
  <path class="logo-bar-1" d={LOCK_PATHS.upperBar}></path>
  <path class="logo-bar-2" d={LOCK_PATHS.lowerBar}></path>
</svg>
