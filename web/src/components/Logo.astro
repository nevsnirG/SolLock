---
import { MARK, MARK_VIEW_BOX } from '../lib/lockIcon.ts';

interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox={MARK_VIEW_BOX} aria-hidden="true">
  <rect class="mark-lock" x={MARK.body.x} y={MARK.body.y} width={MARK.body.width} height={MARK.body.height} rx={MARK.body.rx}></rect>
  <path class="mark-shackle" d={MARK.shackle} stroke-width={MARK.shackleWidth}></path>
  <path class="mark-sun" d={MARK.sun}></path>
</svg>
