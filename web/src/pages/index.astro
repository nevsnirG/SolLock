---
import { formatSol, MIN_LOCK_AMOUNT } from '@sollock/core';
import { SALE_PRICE_2020_USD } from '../config.ts';
import Base from '../layouts/Base.astro';
import { YEAR_PRESETS } from '../lib/unlockDate.ts';

const EXAMPLE_SPEND = 1000;
const usd = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
---

<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="then-now" data-sale={SALE_PRICE_2020_USD}>
        <span>March 2020 <b>${SALE_PRICE_2020_USD.toFixed(2)}</b></span>
        <span class="arrow" id="arrow" aria-hidden="true" hidden>→</span>
        <span id="today" hidden>Today <b id="todayPrice"></b></span>
        <span class="multiple" id="multiple" hidden></span>
      </p>
      <h1 id="heroTitle" data-spend={EXAMPLE_SPEND}>
        <span>{usd(EXAMPLE_SPEND)} in Solana in 2020</span>{' '}
        <span>is <em class="worth pending" id="worth"></em> today.</span>
      </h1>
      <p class="hero-sub">
        <b id="multipleLine" hidden>That's <span id="multipleText"></span>× your money, for anyone who held on.</b>{' '}
        Holding is the hard part. Lock your Solana until a date you choose, and nobody can move it before then, not even you.
      </p>
      <div class="hero-cta">
        <a class="btn big cta" href="/lock">Lock Solana</a>
        <a class="btn big ghost" href="/lock?test">Try a free test lock</a>
      </div>
      <p class="hero-note" id="priceNote">
        $0.22 was Solana's public sale price on 24 March 2020. Past results are no guarantee of future results: crypto prices move both
        ways.
      </p>
    </div>

    <form class="quick" action="/lock" method="get" aria-labelledby="quickTitle">
      <h2 id="quickTitle">Start your lock</h2>
      <label class="q" for="quickAmount">How much Solana?</label>
      <div class="quick-amount">
        <input id="quickAmount" name="amount" type="number" inputmode="decimal" min={formatSol(MIN_LOCK_AMOUNT)} step="any" placeholder="10" required />
        <span>SOL</span>
      </div>
      <fieldset>
        <legend>For how long?</legend>
        <div class="seg">
          {
            YEAR_PRESETS.map((years) => (
              <label>
                <input type="radio" name="years" value={years} checked={years === 1} />
                <span>{years === 1 ? '1 year' : `${years} years`}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <button class="btn wide" type="submit">Continue</button>
      <p class="quick-foot">Next you see the exact cost. Nothing moves until you approve it in your wallet.</p>
      <div class="quick-buy">
        <p>No Solana yet?</p>
        <a class="btn ghost small" href="/lock?buy">
          Buy Solana
          <svg class="go" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
        </a>
      </div>
    </form>
  </section>

  <section class="section" aria-labelledby="whyTitle">
    <div class="section-head">
      <h2 id="whyTitle">Why lock your Solana?</h2>
      <p>Buying is easy. Holding on when the market gets loud is the hard part. A lock makes that decision for you, in advance.</p>
    </div>
    <ul class="benefits">
      <li class="benefit">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="3"></circle><path d="M12 22V8"></path><path d="M5 12H2a10 10 0 0 0 20 0h-3"></path></svg>
        </span>
        <h3>Ride out the dips</h3>
        <p>When the price drops, selling in a panic is tempting. With a lock, that choice is off the table until your date.</p>
      </li>
      <li class="benefit">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        </span>
        <h3>Tune out the noise</h3>
        <p>Stop checking the price ten times a day. Your date is set, so the daily swings can wait.</p>
      </li>
      <li class="benefit">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"
            ><rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M12 8v13"></path><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"
            ></path><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"></path></svg
          >
        </span>
        <h3>A gift that opens later</h3>
        <p>Lock Solana for a child or a friend, to open on an 18th birthday, a graduation or a wedding. From that day it's theirs.</p>
      </li>
      <li class="benefit">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="5.5"></circle><path d="M21 2l-9.6 9.6"></path><path d="M15.5 7.5l3 3L22 7l-3-3"></path></svg>
        </span>
        <h3>Yours the whole time</h3>
        <p>Your Solana sits in an account on the Solana network that only your wallet can withdraw from, on your date.</p>
      </li>
    </ul>
  </section>

  <section class="section" id="how" aria-labelledby="howTitle">
    <div class="section-head">
      <h2 id="howTitle">Three steps, one signature</h2>
      <p>All you need is a Solana wallet, like Phantom, Solflare or Backpack.</p>
    </div>
    <ol class="how">
      <li>
        <span class="n" aria-hidden="true">1</span>
        <h3>Pick an amount and a date</h3>
        <p>A year, ten years, or New Year's Day 2032. A free test lock shows you how it works first.</p>
      </li>
      <li>
        <span class="n" aria-hidden="true">2</span>
        <h3>Sign once in your wallet</h3>
        <p>You see exactly what you sign, and your wallet shows it again before you approve.</p>
      </li>
      <li>
        <span class="n" aria-hidden="true">3</span>
        <h3>Withdraw on the date</h3>
        <p>From the date on, take it out in one step on My locks, or with another Solana wallet tool.</p>
      </li>
    </ol>
  </section>

  <section class="trust" aria-labelledby="trustTitle">
    <div class="section-head">
      <h2 id="trustTitle">A date that holds</h2>
      <p>The lock is part of the Solana network itself. SolLock builds it in your browser, your wallet signs it, and the network keeps it.</p>
    </div>
    <ul class="trust-points">
      <li>
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
        </span>
        <h3>The network keeps the date</h3>
        <p>
          Before the date, the Solana network refuses every withdrawal. Each lock names a custodian address without a key, so nobody can
          open it early. <a href="/custodian">How that works</a>
        </p>
      </li>
      <li>
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"></path></svg>
        </span>
        <h3>Works with any Solana tool</h3>
        <p>Your lock lives on the blockchain. On the date, withdraw on My locks or with other Solana wallet tools, with or without this website.</p>
      </li>
      <li>
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M19 5L5 19"></path><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>
        </span>
        <h3>One clear fee</h3>
        <p>0.25% of the amount, at least 0.01 SOL, VAT included. Test locks are free.</p>
      </li>
    </ul>
    <div class="caution">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4M12 16h.01"></path></svg>
      <p><b>Only lock what you can leave alone.</b> Before the date, nobody can get it out, including you. Crypto prices move both ways.</p>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="ctaTitle">
    <h2 id="ctaTitle">Pick your date.</h2>
    <p>Start with a free test lock, or lock the real thing.</p>
    <div class="hero-cta">
      <a class="btn big" href="/lock">Lock Solana</a>
      <a class="btn big ghost" href="/lock?test">Try a free test lock</a>
    </div>
  </section>
  <section class="section home-faq" aria-labelledby="faqTitle">
    <div class="section-head">
      <h2 id="faqTitle">Questions</h2>
      <p>The short answers.</p>
      <a class="more-link" href="/faq">All questions</a>
    </div>
    <div class="faq">
      <details>
        <summary>Can I unlock early?</summary>
        <div class="a">
          <p>No. The Solana network checks the date on every withdrawal, and the date is fixed once the lock exists.</p>
        </div>
      </details>
      <details>
        <summary>What if this website goes away?</summary>
        <div class="a">
          <p>
            Your lock carries on: it lives on the Solana blockchain. After the date, other Solana tools can withdraw it with your wallet's
            key. The recovery note you get with every lock says how.
          </p>
        </div>
      </details>
      <details>
        <summary>What if I lose my keys?</summary>
        <div class="a">
          <p>
            Then your Solana is gone, for good. A lock only opens for the wallet that owns it, so back up your wallet's recovery phrase before
            you lock anything, and start with a free test lock.
          </p>
        </div>
      </details>
      <details>
        <summary>What does it cost?</summary>
        <div class="a">
          <p>
            0.25% of the amount, at least 0.01 SOL, VAT included, paid in the same transaction. Test locks are free.
            On top come the Solana network fee (a fraction of a cent) and a rent deposit of about 0.0017 SOL, which comes back when you
            withdraw.
          </p>
        </div>
      </details>
    </div>
  </section>

</Base>

<script>
  const sale = Number(document.querySelector<HTMLElement>('.then-now')?.dataset.sale);
  const title = document.getElementById('heroTitle');
  const spend = Number(title?.dataset.spend);
  const element = (id: string) => document.getElementById(id);
  const usd = (amount: number, digits: number) =>
    new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: digits, maximumFractionDigits: digits }).format(amount);

  type Quote = { perSol: number; asOf: number };
  const isQuote = (body: unknown): body is Quote => {
    const { perSol, asOf } = (body ?? {}) as Record<string, unknown>;
    return typeof perSol === 'number' && perSol > 0 && typeof asOf === 'number';
  };

  function showSolBought() {
    if (title) title.textContent = `${usd(spend, 0)} in Solana in 2020 bought ${Math.floor(spend / sale).toLocaleString('en-US')} SOL.`;
  }

  function showWorthToday({ perSol, asOf }: Quote) {
    const times = Math.round(perSol / sale).toLocaleString('en-US');
    const worth = element('worth');
    worth?.classList.remove('pending');
    for (const [id, text] of [
      ['todayPrice', usd(perSol, 2)],
      ['multiple', `${times}×`],
      ['multipleText', times],
      ['worth', usd((spend / sale) * perSol, 0)],
    ] as const) {
      const target = element(id);
      if (target) target.textContent = text;
    }
    for (const id of ['arrow', 'today', 'multiple', 'multipleLine']) element(id)?.removeAttribute('hidden');
    const time = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(asOf * 1000);
    const note = element('priceNote');
    if (note) {
      note.textContent = `${usd(sale, 2)} was Solana's public sale price on 24 March 2020; today's price is from CoinGecko at ${time}. Past results are no guarantee of future results: crypto prices move both ways.`;
    }
  }

  if (sale > 0 && spend > 0) {
    fetch('/api/price?currency=USD')
      .then((response) => (response.ok ? response.json() : null))
      .then((body: unknown) => (isQuote(body) ? showWorthToday(body) : showSolBought()))
      .catch(showSolBought);
  }
</script>
