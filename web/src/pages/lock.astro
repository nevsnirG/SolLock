---
import LockBuilder from '../islands/LockBuilder.tsx';
import Base from '../layouts/Base.astro';
---

<Base title="Lock Solana" description="Lock your own Solana until a date you pick, in a Solana account with a built-in time lock, signed in your own wallet.">
  <section class="intro flow-intro">
    <h1>Lock your Solana</h1>
    <p>A few quick questions. Nothing moves until you approve it in your wallet.</p>
  </section>

  <LockBuilder client:only="react">
    <div slot="fallback" class="flow">
      <p class="lede">Loading…</p>
      <noscript>
        <p class="note warn">
          Locking needs JavaScript. It runs only in your browser: the transaction is built here and signed in your own wallet.
        </p>
      </noscript>
    </div>
  </LockBuilder>
</Base>
