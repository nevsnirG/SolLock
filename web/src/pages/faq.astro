---
import Base from '../layouts/Base.astro';
import { breadcrumbs, type FaqItem, faqPage } from '../lib/structured.ts';

/** Each answer is a list of paragraphs in HTML. The same text goes into the FAQPage structured data. */
const FAQ: readonly FaqItem[] = [
  {
    question: 'What if I lose my keys?',
    answer: [
      `Then your Solana is gone, for good. A lock only opens for the wallet that owns it, so its recovery phrase is the one way back in.`,
      `Back up your wallet's recovery phrase offline before you lock anything, start with a free test lock, and keep the recovery note with your important papers. Your recovery phrase stays with you: SolLock only ever asks your wallet for a signature.`,
    ],
  },
  {
    question: 'Can I unlock early?',
    answer: [
      `No. The Solana network checks the date on every withdrawal, and the date is fixed once the lock exists.`,
      `Why that holds, field by field: <a href="/learn/can-you-unlock-solana-early">Can you unlock Solana early?</a>`,
    ],
  },
  {
    question: 'Who could open it early?',
    answer: [
      `Nobody. You sign the transaction in your own wallet, and your Solana goes into an account with a built-in time lock, which the network keeps shut until the date. A lockup has one key that could open it early, the custodian. Every SolLock lock names an address that has no key, and <a href="/custodian">how it is made</a> is public.`,
    ],
  },
  {
    question: 'What does it cost?',
    answer: [
      `0.25% of the amount, at least 0.01 SOL, VAT included, paid in the same transaction. Test locks are free. On top come the Solana network fee (a fraction of a cent) and a rent deposit of about 0.0017 SOL, which stays in the lock and comes back when you withdraw.`,
      `What the deposit is for: <a href="/learn/solana-rent-deposit">The rent deposit on a Solana lock, explained</a>.`,
    ],
  },
  {
    question: 'What is SolLock for?',
    answer: [
      `Keeping your own hands off your Solana until a date you choose: a commitment device. It stays yours and keeps moving with the price of Solana, which can go down. You can sell it again from the unlock date.`,
      `It is not staking, and it earns nothing: see <a href="/learn/solana-locking-vs-staking">Locking vs staking Solana</a>. Why a lock beats willpower: <a href="/learn/stop-selling-crypto-in-a-dip">How to stop yourself from selling crypto in a dip</a>.`,
    ],
  },
  {
    question: 'What about taxes?',
    answer: [
      `You still own the locked Solana. In the Netherlands it counts for Box 3, valued on 1 January, even while it is locked. The Box 3 rules from 2028 are still being settled. A lock you give away may count as a gift for gift tax.`,
      `This is not tax advice. Ask a tax adviser about your own situation.`,
    ],
  },
  {
    question: 'What if this website goes away?',
    answer: [
      `Your lock carries on: it lives on the blockchain as a regular Solana account. Solana calls this kind, the one with a built-in time lock, a "stake account", so block explorers such as Solana Explorer and Solscan list it under that name. After the date, any tool that handles stake accounts can take the Solana out with your wallet's key, including the Solana command-line tool. The recovery note says how.`,
      `How to read your lock on a block explorer: <a href="/learn/verify-solana-lock-on-chain">How to check a Solana lock on the blockchain</a>.`,
    ],
  },
  {
    question: 'What can go wrong?',
    answer: [
      `Mostly things on your side of the lock: a lost recovery phrase, a date further away than your plans, a wrong address on a gift, or a lock made elsewhere whose custodian does have a key. The price of Solana moves both ways too, and a lock changes nothing about that.`,
      `All of them, and what cannot happen: <a href="/learn/solana-time-lock-risks">What can go wrong with a Solana time lock</a>.`,
    ],
  },
  {
    question: 'What happens on the unlock date?',
    answer: [
      `The lock opens at the time you picked, usually 00:00 UTC. From then on you can withdraw everything, deposit included, in one step on My locks. The network's own clock can run a minute or two behind, so right at that moment a withdrawal may need a short wait.`,
      `Step by step, with and without SolLock: <a href="/learn/withdraw-solana-stake-account-after-lockup">How to withdraw from a Solana stake account after the lockup ends</a>.`,
    ],
  },
  {
    question: 'I want to give a lock as a gift. What does the recipient need?',
    answer: [
      `A wallet they hold themselves, like Phantom or Solflare, and its address. An exchange deposit address can't withdraw from a lock. Ask them to back up their recovery phrase. A gift is final.`,
      `What to check before you lock, and what to hand over: <a href="/learn/give-solana-as-a-gift">How to give Solana as a gift that opens on a date</a>.`,
    ],
  },
  {
    question: 'What is a test lock?',
    answer: [
      `0.01 SOL, locked for about 24 hours, free: you pay only the network fee and the rent deposit, which comes back. It shows you how locking and withdrawing work before you lock more.`,
    ],
  },
  {
    question: 'What exactly do I sign?',
    answer: [
      `One transaction with five parts: a compute limit, creating the lock account, setting the lockup (the date, the custodian with no key, and who can withdraw), our fee, and a short label. Your browser builds it, reads it back and checks every field; you can see it all under "The full transaction". Your wallet shows it again before you approve.`,
      `What each field means: <a href="/learn/solana-stake-account-lockup">How Solana stake account lockups work</a>.`,
    ],
  },
  {
    question: 'Where can I get Solana?',
    answer: [
      `Under "Need Solana first?" on the lock page are exchanges that sell Solana, listed alphabetically. Their links are affiliate links, as the note under them says: if you sign up through one, we may earn a commission from the exchange, and your price stays the same. See <a href="/affiliates">affiliate links</a>.`,
    ],
  },
  {
    question: 'What does SolLock keep about me?',
    answer: [
      `Only what your own browser keeps for you: your currency, your theme and the wallet you connected last. Your locks live on the blockchain, which is public. See the <a href="/privacy">privacy statement</a>.`,
    ],
  },
];
---

<Base
  title="FAQ"
  description="Answers about locking Solana with SolLock: lost keys, early unlocks, cost, taxes, gifts, test locks, what can go wrong, and what happens if this site goes away."
  structured={[faqPage(FAQ), breadcrumbs([{ name: 'FAQ' }])]}
>
  <h1 class="section-title">FAQ</h1>
  <div class="faq">
    {
      FAQ.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.question}</summary>
          <div class="a">
            {item.answer.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
          </div>
        </details>
      ))
    }
  </div>
</Base>
