---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CLUSTER, SITE_DESCRIPTION, SITE_TITLE } from '../config.ts';
import { jsonLd } from '../lib/jsonLd.ts';
import { breadcrumbs } from '../lib/structured.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  /** schema.org blocks for the page. Left out, every page but the home page gets a breadcrumb trail. */
  structured?: readonly unknown[];
}
const {
  title,
  image = '/og/default.png',
  description = SITE_DESCRIPTION,
  type = 'website',
  published,
  modified,
  structured,
} = Astro.props;
const fullTitle = `${title ?? SITE_TITLE} · SolLock`;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(path, Astro.site);
const modifiedAt = modified ?? published;
const blocks = structured ?? (path === '/' ? [] : [breadcrumbs([{ name: title ?? 'SolLock' }])]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100e0c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="SolLock" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SolLock: a time lock for your own Solana" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {CLUSTER === 'devnet' && <meta name="robots" content="noindex" />}
    {blocks.length > 0 && <script type="application/ld+json" set:html={jsonLd(blocks)} />}
    <slot name="head" />
  </head>
  <body>
    <!-- Blocking so the saved theme applies before first paint; after Astro's CSP <meta> so the policy covers it. -->
    <script is:inline src="/theme.js"></script>
    <div class="shell">
      {
        CLUSTER === 'devnet' && (
          <p class="stage">
            <span><b>Devnet preview</b> with test Solana. Set your wallet to devnet before you connect it.</span>
          </p>
        )
      }
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
