---
import '../styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CLUSTER, SITE_DESCRIPTION, SITE_TITLE } from '../config.ts';
import { jsonLd } from '../lib/jsonLd.ts';
import { pageTitle } from '../lib/pageTitle.ts';
import { breadcrumbs } from '../lib/structured.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** What the image shows, for people who cannot see it. */
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  /** schema.org blocks for the page. Left out, every page but the home page gets a breadcrumb trail. */
  structured?: readonly unknown[];
  /** The page lays out its own full-width sections, so <main> adds no column or padding around them. */
  bleed?: boolean;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}
const {
  title,
  image = '/og/default.png',
  imageAlt = 'SolLock: a time lock for your own Solana',
  description = SITE_DESCRIPTION,
  type = 'website',
  published,
  modified,
  structured,
  bleed = false,
  noindex = false,
} = Astro.props;
const fullTitle = pageTitle(title ?? SITE_TITLE);
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(path, Astro.site);
const modifiedAt = modified ?? published;
const blocks = structured ?? (path === '/' ? [] : [breadcrumbs([{ name: title ?? 'SolLock' }])]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="no-referrer" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- The header is ink in both themes, so the browser's own bar matches it. -->
    <meta name="theme-color" content="#0b0b0a" />
    <!-- The text font, fetched early so the first paint already has it. -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="SolLock" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {(noindex || CLUSTER === 'devnet') && <meta name="robots" content="noindex" />}
    {blocks.length > 0 && <script type="application/ld+json" set:html={jsonLd(blocks)} />}
    <slot name="head" />
  </head>
  <body>
    <!-- Blocking so the saved theme applies before first paint; after Astro's CSP <meta> so the policy covers it. -->
    <script is:inline src="/theme.js"></script>
    <a class="skip" href="#main">Skip to content</a>
    {
      CLUSTER === 'devnet' && (
        <p class="stage">
          <span><b>Devnet preview</b> with test Solana. Set your wallet to devnet before you connect it.</span>
        </p>
      )
    }
    <Header />
    <main id="main" class={bleed ? undefined : 'wrap page'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
